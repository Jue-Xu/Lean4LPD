end Lean4LPD.LayerErrorRegression

namespace Lean4LPD.LayerErrorThreeQubitRegression

open PauliString

/-- The first two-local generator `XXI` of the three-qubit test of
`apd:thm:one_step_truncation_error`. -/
def G1 : PauliString 3 := ⟨![1, 1, 0], ![0, 0, 0], 0⟩
/-- The second two-local generator `-IZX` of the same test. -/
def G2 : PauliString 3 := ⟨![0, 0, 1], ![0, 1, 0], 2⟩
/-- The weight-one input `ZII`. -/
def P : PauliString 3 := ⟨![0, 0, 0], ![1, 0, 0], 0⟩
/-- The weight-two Pauli `YXI` that the first rotation creates from the input. -/
def Q : PauliString 3 := ⟨![1, 1, 0], ![1, 0, 0], 1⟩
/-- The weight-three Pauli `YYX`, above the cutoff `w* = 2` that corresponds to `m* = 1`. -/
def R : PauliString 3 := ⟨![1, 1, 1], ![1, 1, 0], 2⟩

/-- `G1` is Hermitian, as `apd:thm:layer_inflow` requires of every generator. -/
theorem hG1 : IsSelfAdjoint G1 := isSelfAdjoint_iff_phase.2 (by decide)
/-- `G2` is Hermitian, as `apd:thm:layer_inflow` requires of every generator. -/
theorem hG2 : IsSelfAdjoint G2 := isSelfAdjoint_iff_phase.2 (by decide)
/-- The weights realise `k_o = 1` and `k_h = 2` exactly, and the created Paulis `Q` and `R` have
weights two and three (`apd:thm:one_step_truncation_error`). -/
theorem weights : weight G1 = 2 ∧ weight G2 = 2 ∧ weight P = 1 ∧ weight Q = 2 ∧ weight R = 3 := by
  decide
/-- The sine partner of `P` under the rotation generated by `G1` is `Q`
(`apd:eq:pauli_rotation_branch`). -/
theorem partner_one : phaseMul 1 (G1 * P) = Q := by decide
/-- The sine partner of `Q` under the rotation generated by `G2` is `R`
(`apd:eq:pauli_rotation_branch`). -/
theorem partner_two : phaseMul 1 (G2 * Q) = R := by decide
/-- `P` is the canonical Hermitian representative of its class. -/
theorem herm_P : herm (cls P) = P := by decide
/-- `Q` is the canonical Hermitian representative of its class. -/
theorem herm_Q : herm (cls Q) = Q := by decide
/-- `R = +YYX` is minus the canonical Hermitian representative `herm (cls R)` of its class, so
its coefficient in the Pauli basis is negative (`apd:eq:pauli_rotation_branch`). -/
theorem R_phase : R = phaseMul 2 (herm (cls R)) := by decide

/-- The input conjugated by the two rotations of the first block, written out directly as a
matrix product (`apd:eq:step_component`). -/
noncomputable def afterTwo (θ : ℝ) : Matrix (Bits 3) (Bits 3) ℂ :=
  rot (toMatrix G2) θ * (rot (toMatrix G1) θ * toMatrix P * rot (toMatrix G1) (-θ)) *
    rot (toMatrix G2) (-θ)

/-- Exact expansion of the two-layer block. The `sin² θ` term is the amplitude for climbing two
rungs within one block, one jump in each layer (`apd:rmk:multijump`). -/
theorem afterTwo_expansion (θ : ℝ) :
    afterTwo θ = (Real.cos θ : ℂ) • toMatrix P +
      ((Real.sin θ : ℂ) * (Real.cos θ : ℂ)) • toMatrix Q +
      (Real.sin θ : ℂ) ^ 2 • toMatrix R := by
  rw [afterTwo, pauli_rotation_branch_anticommute_hermitian hG1 (by decide), partner_one]
  simp only [Matrix.mul_add, Matrix.add_mul, Matrix.mul_smul, Matrix.smul_mul]
  rw [pauli_rotation_branch_commute hG2 (show sympForm G2 P = 0 by decide),
    pauli_rotation_branch_anticommute_hermitian hG2 (show sympForm G2 Q = 1 by decide), partner_two]
  simp only [smul_add, smul_smul, pow_two, add_assoc]

/-- Pauli coefficients commute with scalar multiplication. Helper for the coefficient
computations below. -/
theorem coeff_smul_local {n : ℕ} (z : ℂ) (A : Matrix (Bits n) (Bits n) ℂ) (p : PauliIndex n) :
    coeff (z • A) p = z * coeff A p := by
  rw [coeff, coeff, Matrix.mul_smul, Matrix.trace_smul, smul_eq_mul]
  ring

/-- The input `P` has no coefficient on the weight-three class of `R`. -/
theorem coeff_P_R : coeff (toMatrix P) (cls R) = 0 := by
  rw [← herm_P, coeff_toMatrix_herm, ite_eq_right (by decide)]
/-- The intermediate Pauli `Q` has no coefficient on the weight-three class of `R`. -/
theorem coeff_Q_R : coeff (toMatrix Q) (cls R) = 0 := by
  rw [← herm_Q, coeff_toMatrix_herm, ite_eq_right (by decide)]
/-- The coefficient of `R = YYX` on its own class is `-1`; the sign comes from the canonical
Hermitian representative, see `R_phase` (`apd:eq:pauli_rotation_branch`). -/
theorem coeff_R_R : coeff (toMatrix R) (cls R) = -1 := by
  have hm : toMatrix R = (-1 : ℂ) • toMatrix (herm (cls R)) := by
    calc
      toMatrix R = toMatrix (phaseMul 2 (herm (cls R))) := congrArg toMatrix R_phase
      _ = (-1 : ℂ) • toMatrix (herm (cls R)) := by rw [toMatrix_phaseMul, iPow_two]
  rw [hm, coeff_smul_local, coeff_toMatrix_herm, ite_eq_left rfl]
  norm_num

/-- The weight-three coefficient of the block output is `-sin² θ`: it is computed, sign
included, rather than assumed to be a positive amplitude (`apd:rmk:multijump`). -/
theorem coeff_afterTwo_R (θ : ℝ) : coeff (afterTwo θ) (cls R) = -(Real.sin θ : ℂ) ^ 2 := by
  rw [afterTwo_expansion, coeff_add, coeff_add, coeff_smul_local, coeff_smul_local,
    coeff_smul_local, coeff_P_R, coeff_Q_R, coeff_R_R]
  ring

/-- For `0 < θ < π` the two-layer output has strictly positive mass above the cutoff two
(`apd:thm:one_step_truncation_error`). -/
theorem highNorm_afterTwo_pos {θ : ℝ} (hθ : 0 < θ) (hθpi : θ < Real.pi) :
    0 < highNorm 2 (afterTwo θ) := by
  apply highNorm_pos_of_coeff_ne_zero (p := cls R) (by decide)
  rw [coeff_afterTwo_R]
  have hs : (Real.sin θ : ℂ) ≠ 0 := by
    exact_mod_cast (ne_of_gt (Real.sin_pos_of_pos_of_lt_pi hθ hθpi))
  exact neg_ne_zero.mpr (pow_ne_zero 2 hs)

/-- A nonzero angle meeting the smallness hypothesis `a ≤ αt/r` of
`pauliNorm_layerStep_error_le_model_of_source_regime` at `α = 1`, `t = 1/50`, `r = 20`
(`apd:thm:one_step_truncation_error`). -/
noncomputable def small : ℝ := 1 / 1000
/-- The generator of layer `T`: `G1` for even `T` and `G2` for odd `T`. -/
def generator (T : ℕ) : PauliString 3 := if T % 2 = 0 then G1 else G2
/-- Singleton layers: each consists of one two-local rotation, so the disjoint-support
condition holds trivially within a layer. -/
noncomputable def layers (T : ℕ) : List (PauliString 3 × ℝ) := [(generator T, small)]

/-- The three-qubit test layers satisfy `IsLayer 2` (`apd:thm:layer_inflow`). -/
theorem layers_isLayer (T : ℕ) : IsLayer 2 ((layers T).map Prod.fst) := by
  constructor
  · simp [layers]
  · intro H hH
    have hH' : H = generator T := by simpa [layers] using hH
    subst H
    unfold generator
    split <;> decide

/-- Every generator of the three-qubit test layers is Hermitian (`apd:thm:layer_inflow`). -/
theorem layers_hermitian (T : ℕ) : ∀ g ∈ layers T, IsSelfAdjoint g.1 := by
  intro g hg
  have hg' : g = (generator T, small) := by simpa [layers] using hg
  subst g
  change IsSelfAdjoint (generator T)
  unfold generator
  split
  · exact hG1
  · exact hG2

/-- The angles obey the absolute-sine bound `|sin θ| ≤ small` (`apd:thm:layer_inflow`). -/
theorem layers_sine_bound (T : ℕ) : ∀ g ∈ layers T, |Real.sin g.2| ≤ small := by
  intro g hg
  have hg' : g = (generator T, small) := by simpa [layers] using hg
  subst g
  simpa [small] using (Real.abs_sin_le_abs (x := small))

/-- The input is `k_o = 1` local on `n = 3` qubits, so `k_o < n`
(`apd:thm:one_step_truncation_error`). -/
theorem input_local (p : PauliIndex 3) (hp : 1 < wt p) : coeff (toMatrix P) p = 0 := by
  rw [← herm_P]
  exact coeff_toMatrix_herm_eq_zero (by simpa [weights.2.2.1] using hp)

/-- The library's block trajectory `layerBlockTraj` coincides with the explicitly written
two-conjugation operator `afterTwo` (`apd:eq:step_component`). -/
theorem block_two_eq : layerBlockTraj layers (toMatrix P) 2 = afterTwo small := by
  simp [layerBlockTraj, layerConj, layers, generator, afterTwo]

/-- **Nonzero discard at `m* = 1`:** with cutoff two on `n = 3` qubits, the first discarded
operator has strictly positive norm, carried by the weight-three Pauli `R`
(`apd:thm:one_step_truncation_error`). -/
theorem first_discard_pos : 0 < pauliNorm (discardedLayerStep layers 2 2 (toMatrix P) 0) := by
  rw [pauliNorm_discardedLayerStep, layerStepTraj_zero, block_two_eq]
  apply highNorm_afterTwo_pos
  · norm_num [small]
  · have h := Real.two_le_pi; norm_num [small]; linarith

/-- The step-count condition `r ≥ 8e²(k_o + k_h − 1)αt` holds at `α = 1`, `t = 1/50`, `r = 20`
with `k_o = 1`, `k_h = 2` (`apd:eq:multijump_factor`). -/
theorem source_step_count : 8 * (Real.exp 1) ^ 2 * ((1 : ℝ) + 2 - 1) * 1 * (1 / 50) ≤ 20 := by
  have hpow := pow_le_pow_left₀ (Real.exp_pos 1).le Real.exp_one_lt_three.le 2
  norm_num at hpow ⊢
  nlinarith

/-- **The error bound in the paper's parameter regime applies where truncation genuinely loses
mass.** Every hypothesis of `pauliNorm_layerStep_error_le_model_of_source_regime` (layer
structure, sine bound, step count, admissibility, `1 ≤ m*`, `5 ≤ r`, input locality) is proved
for the test data; no bound on `β`, on `B = 4eβ`, or on the per-step sum is assumed
(`apd:thm:one_step_truncation_error`/`apd:eq:time_condition`). -/
theorem model_bound_instance :
    pauliNorm (((layerBlockEnd layers 2) ^ 20) (toMatrix P) -
        layerStepTraj layers 2 2 (toMatrix P) 20) ≤
      decayBase 2 2 1 (1 / 50) ^ 2 * (Real.exp 1 * 2) * pauliNorm (toMatrix P) := by
  convert pauliNorm_layerStep_error_le_model_of_source_regime layers 2 (toMatrix P)
    (ko := 1) (kh := 2) (m := 1) (r := 20) (a := small) (α := 1) (t := 1 / 50)
    (by decide) (by decide) layers_isLayer layers_hermitian (by norm_num [small]) layers_sine_bound
    (by norm_num) (by norm_num) (by norm_num [small]) (by simpa using source_step_count)
    (by norm_num [Admissible]) (by decide) (by decide) input_local using 1 <;> norm_num [rungWeight]

/-- The sum of discarded norms over the `r = 20` steps is strictly positive, so the summed bound
`apd:eq:total_high_weight_norm` is exercised on a nonzero left-hand side rather than on an empty
high-weight sector. -/
theorem model_discard_sum_pos :
    0 < ∑ d ∈ Finset.range 20, pauliNorm (discardedLayerStep layers 2 2 (toMatrix P) d) := by
  exact first_discard_pos.trans_le
    (Finset.single_le_sum (fun d _ => pauliNorm_nonneg _) (by simp : 0 ∈ Finset.range 20))

/-- The same data satisfy `t < tZeroModel`: the decay base is below one, so the instance lies
in the short-time regime of `apd:eq:time_condition`, where the right-hand side of
`model_bound_instance` is a genuine decay factor. -/
theorem inside_model_threshold : decayBase 2 2 1 (1 / 50) < 1 := by
  apply decayBase_lt_one (by norm_num) (by norm_num) (by norm_num)
  norm_num [tZeroModel]

